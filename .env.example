# Export these variables in your shell; .env is not automatically loaded.
FARESCOUT_DB=farescout.db
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM=
ALERT_TO=

# First use a Duffel test token. Sandbox prices are simulated.
DUFFEL_ACCESS_TOKEN=
# Leave 0 until account activation, search fees and intended usage are reviewed.
DUFFEL_ALLOW_LIVE=0
# Persistent server-wide daily quota, UTC day; failed provider attempts count too.
DUFFEL_DAILY_SEARCH_LIMIT=20
